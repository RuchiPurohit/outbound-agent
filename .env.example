# Local dashboard
OUTBOUND_PORT=3000
OUTBOUND_DB_PATH=data/outbound.sqlite
EMAIL_TEST_RECIPIENT=

# Select the transport used for test and approved sends: gmail or mcp
EMAIL_TRANSPORT=gmail

# Google OAuth client type: Web application. Do not commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SENDER_EMAIL=
# Register this exact URI in Google Cloud. Update it if OUTBOUND_PORT changes.
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/gmail/callback
# Optional default for the test-send form (not a prospect address).
GMAIL_TEST_RECIPIENT=

# Custom Mail MCP OAuth (Not required if custom email server/non gmail server is not used)
EMAIL_TRANSPORT=mcp
MCP_EMAIL_URL=https://your-mail-mcp.example/mcp
MCP_EMAIL_SENDER_EMAIL=
MCP_EMAIL_REDIRECT_URI=http://127.0.0.1:3000/gmail/callback
MCP_EMAIL_SEND_TOOL=
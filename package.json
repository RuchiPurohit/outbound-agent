{
  "name": "outbound-agent",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "campaign:create": "npm run build --silent && node dist/src/commands/createCampaign.js",
    "campaign:list": "npm run build --silent && node dist/src/commands/listCampaigns.js",
    "companies:list": "npm run build --silent && node dist/src/commands/listCompanies.js",
    "companies:approve": "npm run build --silent && node dist/src/commands/approveCompanies.js",
    "companies:reject": "npm run build --silent && node dist/src/commands/rejectCompanies.js",
    "contacts:discover": "npm run build --silent && node dist/src/commands/discoverContacts.js",
    "contacts:list": "npm run build --silent && node dist/src/commands/listContacts.js",
    "contacts:approve": "npm run build --silent && node dist/src/commands/approveContacts.js",
    "contacts:reject": "npm run build --silent && node dist/src/commands/rejectContacts.js",
    "emails:discover": "npm run build --silent && node dist/src/commands/discoverEmails.js",
    "dashboard": "npm run build --silent && node dist/src/web/server.js",
    "test": "npm run build && node --test dist/test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Local, human-in-the-loop outbound sales workflow",
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
